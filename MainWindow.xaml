<Window x:Class="AudioPitchShifter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioPitchShifter"
        Title="Real-Time Pitch Shifter" Width="640"
        SizeToContent="Height"
        Icon="pack://application:,,,/aps.png"
        Closing="Window_Closing"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Converters -->
        <local:PercentageConverter x:Key="PercentageConverter"/>
        <local:SpectrumColorConverter x:Key="SpectrumColorConverter"/>

        <!-- Gradient Brush for Spot Color (Audio Level Bar) -->
        <LinearGradientBrush x:Key="SpotGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000000" Offset="0.0"/>
            <GradientStop Color="#FF1493" Offset="0.2"/>
            <GradientStop Color="#FF0000" Offset="0.4"/>
            <GradientStop Color="#FF8C00" Offset="0.6"/>
            <GradientStop Color="#FFD700" Offset="0.8"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                BorderThickness="2"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <TextBlock x:Name="contentText"
                                      Text="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.67"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Unchecked (Start) State - Retro Purple -->
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="#8B5CF6"/>
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="Start!"/>
                </Trigger>
                <!-- Checked (Stop) State - Dark Grey with Solid Purple Border -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                    <Setter Property="Foreground" Value="#8B5CF6"/>
                    <Setter Property="Content" Value="Stop"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="5,3,0,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="5,3,23,3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                            </ContentPresenter>
                            <Popup Name="Popup"
                                 Placement="Bottom"
                                 IsOpen="{TemplateBinding IsDropDownOpen}"
                                 AllowsTransparency="True"
                                 Focusable="False"
                                 PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                          Background="#0D0D0D"
                                          BorderThickness="1"
                                          BorderBrush="#404040"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#0D0D0D"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Padding" Value="5,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8B5CF6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slider Repeat Button Style (Must be defined before Slider Style) -->
        <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Thumb Style (Must be defined before Slider Style) -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#E0E0E0" Stroke="#8B5CF6" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource SpotGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Grid.Row="0" Fill="#2A2A2A" Height="4" Placement="Top" Visibility="Collapsed"/>
                            <Border x:Name="TrackBackground" Grid.Row="1" Background="#404040" BorderBrush="#404040" BorderThickness="1" Height="4" Margin="5,0"/>
                            <Track Grid.Row="1" x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <TickBar x:Name="BottomTick" Grid.Row="2" Fill="#2A2A2A" Height="4" Placement="Bottom"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TickPlacement" Value="TopLeft">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="Both">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource SpotGradient}"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Outer Border for rounded corners and purple border -->
    <Border BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="7" Background="#1A1A1A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#4F3485" CornerRadius="5,5,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="8,0,0,0">
                        <Image Source="pack://application:,,,/aps.png"
                              Width="20"
                              Height="20"
                              Margin="0,0,8,0"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Real-Time Pitch Shifter"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton" Content="−" Width="46" Height="32"
                               Background="Transparent" Foreground="White" BorderThickness="0"
                               FontSize="18" Click="MinimizeButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC143C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="MaximizeButton" Content="□" Width="46" Height="32"
                               Background="Transparent" Foreground="White" BorderThickness="0"
                               FontSize="19" Click="MaximizeButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC143C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseButton" Content="✕" Width="46" Height="32"
                               Background="Transparent" Foreground="White" BorderThickness="0"
                               FontSize="14" Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0,5,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC143C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Audio Input Device:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
        <ComboBox Grid.Row="1" x:Name="InputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="InputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="2" Text="Audio Output Device:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
        <ComboBox Grid.Row="3" x:Name="OutputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="OutputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="4" Text="Pitch Shift (Semitones):" FontWeight="Bold" Margin="0,0,0,8" Foreground="#E0E0E0"/>
        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PitchSlider"
                    Grid.Column="0"
                    Minimum="-12"
                    Maximum="12"
                    Value="0"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    ValueChanged="PitchSlider_ValueChanged"
                    Margin="0,0,0,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PitchValueText"
                           Text="0"
                           FontWeight="Bold"
                           FontSize="22"
                           MinWidth="42"
                           TextAlignment="Right"
                           Foreground="#E0E0E0"/>
                <TextBlock x:Name="MusicalNotationText"
                           Text="E"
                           FontWeight="Normal"
                           FontSize="16"
                           MinWidth="42"
                           TextAlignment="Right"
                           Foreground="#808080"/>
            </StackPanel>
        </Grid>

        <ToggleButton Grid.Row="6"
                      x:Name="ToggleButton"
                      Style="{StaticResource ToggleButtonStyle}"
                      Height="40"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,20"
                      Checked="ToggleButton_Checked"
                      Unchecked="ToggleButton_Unchecked"/>

        <!-- Status and Spectrum Analyzer Section -->
        <Border Grid.Row="7"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Background="#2A2A2A">
            <StackPanel>
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,0,0,10" Foreground="#B0B0B0"/>

                <TextBlock Text="Audio Level:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                <ProgressBar x:Name="AudioLevelBar"
                            Height="20"
                            Minimum="0"
                            Maximum="1"
                            Value="0"/>

                <!-- Spectrum Color Style Selection -->
                <Grid Margin="0,15,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Frequency Spectrum:" FontWeight="Bold" Foreground="#E0E0E0"/>
                    <TextBlock Grid.Column="1" Text="Color Style:" FontWeight="Bold" Margin="20,0,5,0" HorizontalAlignment="Right" Foreground="#E0E0E0"/>
                    <ComboBox Grid.Column="2" x:Name="SpectrumColorStyleComboBox" MinWidth="120" SelectionChanged="SpectrumColorStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Rainbow" IsSelected="True"/>
                        <ComboBoxItem Content="Monochrome"/>
                        <ComboBoxItem Content="Fire"/>
                        <ComboBoxItem Content="Ocean"/>
                    </ComboBox>
                </Grid>
                <!-- Spectrum Analyzer -->
                <ItemsControl x:Name="SpectrumAnalyzer" Height="100">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="36"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="1,0" x:Name="BarContainer">
                                <Rectangle Fill="#404040" VerticalAlignment="Stretch"/>
                                <Grid VerticalAlignment="Bottom">
                                    <Grid.Height>
                                        <MultiBinding Converter="{StaticResource PercentageConverter}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Grid.Height>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <SolidColorBrush>
                                                <SolidColorBrush.Color>
                                                    <MultiBinding Converter="{StaticResource SpectrumColorConverter}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="DataContext.SpectrumColorStyle"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items.Count"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid, AncestorLevel=2}" Path="(ItemsControl.AlternationIndex)"/>
                                                    </MultiBinding>
                                                </SolidColorBrush.Color>
                                            </SolidColorBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
