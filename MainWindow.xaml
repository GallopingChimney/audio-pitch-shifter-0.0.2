<Window x:Class="AudioPitchShifter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Real-Time Pitch Shifter" Height="450" Width="390"
        Closing="Window_Closing"
        Background="#1A1A1A">
    <Window.Resources>
        <!-- Gradient Brush for Spot Color -->
        <LinearGradientBrush x:Key="SpotGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000000" Offset="0.0"/>
            <GradientStop Color="#FF1493" Offset="0.2"/>
            <GradientStop Color="#FF0000" Offset="0.4"/>
            <GradientStop Color="#FF8C00" Offset="0.6"/>
            <GradientStop Color="#FFD700" Offset="0.8"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                BorderThickness="2"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <TextBlock x:Name="contentText"
                                      Text="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Unchecked (Start) State - Retro Purple -->
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="#8B5CF6"/>
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="Start"/>
                </Trigger>
                <!-- Checked (Stop) State - Dark Grey with Gradient Border -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SpotGradient}"/>
                    <Setter Property="Foreground" Value="{StaticResource SpotGradient}"/>
                    <Setter Property="Content" Value="Stop"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource SpotGradient}"/>
        </Style>

        <!-- ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource SpotGradient}"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Audio Input Device:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
        <ComboBox Grid.Row="1" x:Name="InputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="InputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="2" Text="Audio Output Device:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
        <ComboBox Grid.Row="3" x:Name="OutputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="OutputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="4" Text="Pitch Shift (Semitones):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
        <Grid Grid.Row="5" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PitchSlider"
                    Grid.Column="0"
                    Minimum="-12"
                    Maximum="12"
                    Value="0"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    ValueChanged="PitchSlider_ValueChanged"
                    Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PitchValueText"
                           Text="0"
                           FontWeight="Bold"
                           FontSize="16"
                           MinWidth="80"
                           TextAlignment="Right"
                           Foreground="#E0E0E0"/>
                <TextBlock x:Name="MusicalNotationText"
                           Text="E"
                           FontWeight="Normal"
                           FontSize="12"
                           MinWidth="80"
                           TextAlignment="Right"
                           Foreground="#808080"/>
            </StackPanel>
        </Grid>

        <ToggleButton Grid.Row="6"
                      x:Name="ToggleButton"
                      Style="{StaticResource ToggleButtonStyle}"
                      Width="200"
                      Height="40"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Checked="ToggleButton_Checked"
                      Unchecked="ToggleButton_Unchecked"/>

        <Border Grid.Row="7"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Background="#2A2A2A">
            <StackPanel>
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,0,0,10" Foreground="#B0B0B0"/>

                <TextBlock Text="Audio Level:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E0E0E0"/>
                <ProgressBar x:Name="AudioLevelBar"
                            Height="20"
                            Minimum="0"
                            Maximum="1"
                            Value="0"/>

                <TextBlock Text="Instructions:" FontWeight="Bold" Margin="0,15,0,5" Foreground="#E0E0E0"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#B0B0B0">
                    1. Select your input device (microphone or VB-Audio Cable)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#B0B0B0">
                    2. Select your output device (speakers or VB-Audio Cable)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#B0B0B0">
                    3. Adjust pitch in semitone intervals (-12 to +12)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="#B0B0B0">
                    4. Click Start to begin real-time processing
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
