<Window x:Class="AudioPitchShifter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Real-Time Pitch Shifter" Height="450" Width="600"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Audio Input Device:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" x:Name="InputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="InputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="2" Text="Audio Output Device:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" x:Name="OutputDeviceComboBox" Margin="0,0,0,15" SelectionChanged="OutputDeviceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="4" Text="Pitch Shift (Semitones):" FontWeight="Bold" Margin="0,0,0,5"/>
        <Grid Grid.Row="5" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PitchSlider"
                    Grid.Column="0"
                    Minimum="-12"
                    Maximum="12"
                    Value="0"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    ValueChanged="PitchSlider_ValueChanged"
                    Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="PitchValueText"
                       Text="0"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Center"
                       MinWidth="40"
                       TextAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="StartButton"
                    Content="Start"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="StartButton_Click"/>
            <Button x:Name="StopButton"
                    Content="Stop"
                    Width="100"
                    Height="40"
                    IsEnabled="False"
                    Click="StopButton_Click"/>
        </StackPanel>

        <Border Grid.Row="7"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Background="#F5F5F5">
            <StackPanel>
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,0,0,10"/>

                <TextBlock Text="Audio Level:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ProgressBar x:Name="AudioLevelBar"
                            Height="20"
                            Minimum="0"
                            Maximum="1"
                            Value="0"/>

                <TextBlock Text="Instructions:" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    1. Select your input device (microphone or VB-Audio Cable)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    2. Select your output device (speakers or VB-Audio Cable)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                    3. Adjust pitch in semitone intervals (-12 to +12)
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    4. Click Start to begin real-time processing
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
